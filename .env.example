# Groq API Key (powers Agentic Routing, Chat, Vision, and Whisper STT)
GROQ_API_KEY=
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Clock timezone and weather location. Enter your venue and decimal coordinates.
AURUS_TIMEZONE=Asia/Colombo
AURUS_LOCATION=
AURUS_WEATHER_LATITUDE=
AURUS_WEATHER_LONGITUDE=

# FIT Expo narration uses PIPER_MODEL_PATH with eSpeak as its local fallback.
# Demo-only bass reduction, presence EQ, compression and peak limiting.
AURUS_DEMO_AUDIO_ENHANCE=true
AURUS_DEMO_TTS_GAIN_DB=6

# Local fallbacks for offline endpointing, speech recognition, and TTS.
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
KWS_MODEL_PATH=models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
KWS_KEYWORDS_PATH=models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/aurus_keywords.txt
VAD_MODEL_PATH=models/silero_vad.onnx
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
MIC_INDEX=
# Digital gain before local wake detection and transcription. 0 disables the boost.
AURUS_MIC_GAIN_DB=6
# Optional ALSA override used when PortAudio/PulseAudio cannot expose the USB mic.
# Example for the device shown as "card 3: Device" by `arecord -l`:
ALSA_CAPTURE_DEVICE=
ALSA_PLAYBACK_DEVICE=
AURUS_MAX_UTTERANCE_SECONDS=10.0
AURUS_SPEECH_START_TIMEOUT=4.0
AURUS_WAKE_ENABLED=true
# Audio output destination: "auto" (Pi speaker with browser fallback), "pi" (Pi speaker only), or "browser" (PC speaker via web dashboard)
AURUS_AUDIO_OUTPUT=auto
# Initial camera state; the dashboard switch changes runtime state until restart.
AURUS_CAMERA_ENABLED=true
# Front-center startup polling switch. In strict coverage mode, false selects
# the existing degraded-front margins; otherwise unavailable sensors are ignored.
AURUS_FRONT_SENSOR_ENABLED=true
# False: unavailable sensors are ignored and remaining valid readings are used.
# All sensors unavailable still stops movement. True restores strict coverage.
AURUS_REQUIRE_FULL_SENSOR_COVERAGE=false

# Motor configurations
MOTOR_SPEED_MULTIPLIER=1.0

AURUS_HOST=0.0.0.0
AURUS_PORT=5000
AURUS_SESSION_SECRET=replace-for-non-local-deployment

# Required to authorize ultrasonic configuration changes. Empty disables changes.
# Use a long random token; enter it in the dashboard. Use a trusted network/HTTPS.
AURUS_SENSOR_OPERATOR_TOKEN=

# Optional distance calibration. Leave blank until physically measured.
# All rates must be measured at this exact speed and the recorded motor settings.
# No linear scaling to other PWM speeds is assumed.
AURUS_DISTANCE_MOTOR_SPEED=
AURUS_DISTANCE_OUTPUT_SCALE=
AURUS_DISTANCE_VECTOR_MULTIPLIER=
AURUS_DISTANCE_FORWARD_CM_S=
AURUS_DISTANCE_BACKWARD_CM_S=
AURUS_DISTANCE_LEFT_CM_S=
AURUS_DISTANCE_RIGHT_CM_S=
